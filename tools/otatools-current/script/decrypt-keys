#!/bin/bash

set -o errexit -o nounset -o pipefail

source "$(dirname ${BASH_SOURCE[0]})/common.sh"

[[ $# -ne 1 ]] && user_error "expected 1 argument (key directory)"

cd $1

[[ "${password+defined}" = defined ]] || read -rp "Enter key passphrase (empty if none): " -s password
echo

tmp="$(mktemp -d /dev/shm/decrypt-keys.XXXXXXXXXX)"
trap "rm -rf \"$tmp\"" EXIT

export password

for key in ${signing_keys[@]}; do
    # WORM: auto-detect unencrypted PKCS#8 DER first.
    # New release keys generated by make_key may be plain DER even when
    # a generation password was supplied.
    if openssl pkey -inform DER -in "$key.pk8" \
        -noout -check >/dev/null 2>&1; then

            # WORM: canonical Java-compatible PKCS#8 DER
            openssl pkey \
                -inform DER \
                -in "$key.pk8" \
                -outform PEM \
                -out "$tmp/$key.pem"

            openssl pkcs8 \
                -topk8 \
                -inform PEM \
                -in "$tmp/$key.pem" \
                -outform DER \
                -nocrypt \
                -out "$tmp/$key.pk8"

            rm -f "$tmp/$key.pem"
    else
        if [[ -z $password ]]; then
            echo "Unable to read $key.pk8 as unencrypted DER and no password supplied" >&2
            return 1 2>/dev/null || false
        fi

        openssl pkcs8 \
            -inform DER \
            -in "$key.pk8" \
            -passin env:password \
            -outform DER \
            -out "$tmp/$key.pk8"
    fi
done

if [[ -f avb.pem ]]; then
    if openssl pkey -in avb.pem \
        -noout -check >/dev/null 2>&1; then

        openssl pkey \
            -in avb.pem \
            -out "$tmp/avb.pem"
    else
        if [[ -z $password ]]; then
            echo "Unable to read avb.pem and no password supplied" >&2
            return 1 2>/dev/null || false
        fi

        openssl pkey \
            -in avb.pem \
            -passin env:password \
            -out "$tmp/avb.pem"
    fi
fi

unset password

mv "$tmp"/* .
