[Unit]
Description=Worm Logs dynamic server-side application
After=network.target

[Service]
Type=simple
User=wormlogs
Group=wormlogs
WorkingDirectory=/opt/worm/services/worm-logs
Environment=TZ=Europe/Rome
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/worm/services/worm-logs/venv/bin/gunicorn --no-control-socket --workers 2 --bind 127.0.0.1:8300 app:app
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/worm/logs
ReadWritePaths=/opt/worm/services/worm-logs /opt/worm/logs/worm-logs
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
