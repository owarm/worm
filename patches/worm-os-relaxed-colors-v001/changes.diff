diff --git a/monet/src/com/android/systemui/monet/RelaxedDynamicScheme.java b/monet/src/com/android/systemui/monet/RelaxedDynamicScheme.java
new file mode 100644
index 00000000..5e514882
--- /dev/null
+++ b/monet/src/com/android/systemui/monet/RelaxedDynamicScheme.java
@@ -0,0 +1,133 @@
+/*
