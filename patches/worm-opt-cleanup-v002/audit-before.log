{margin:18px 0 0;color:var(--muted);font-size:1.05rem;line-height:1.6}.timeline{position:relative;padding-left:18px}.timeline-line{position:absolute;left:9px;top:0;bottom:0;width:2px;background:linear-gradient(var(--line),transparent)}.timeline-root{display:grid;gap:18px}.entry{position:relative;margin-left:18px;background:var(--panel);border:1px solid color-mix(in srgb,var(--line) 70%,transparent);border-radius:20px;box-shadow:var(--shadow);overflow:clip}.entry summary{cursor:pointer;list-style:none}.entry summary::-webkit-details-marker{display:none}.marker{position:absolute;left:-28px;top:26px;width:16px;height:16px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 5px var(--accent-soft)}.entry-head{padding:22px 22px 14px}.entry-meta{display:flex;flex-wrap:wrap;gap:10px;color:var(--muted);font-size:.9rem}.title{margin:10px 0 8px;font-size:1.5rem}.summary{margin:0;color:var(--muted);line-height:1.55}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.chip{display:inline-flex;align-items:center;min-height:28px;padding:0 12px;border-radius:999px;background:var(--chip);color:var(--muted);font-size:.82rem;font-weight:600}.details{padding:0 22px 22px;border-top:1px solid color-mix(in srgb,var(--line) 60%,transparent)}.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin:18px 0 0}.grid dt{font-size:.76rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}.grid dd{margin:6px 0 0;line-height:1.5}.grid ul,.changes{margin:10px 0 0;padding-left:18px}.changes li+.changes li,.files li+.files li{margin-top:8px}.loading{color:var(--muted)}@media (max-width:720px){.shell{width:min(100% - 22px,1040px);padding-top:28px}.timeline{padding-left:10px}.marker{left:-20px}.entry-head,.details{padding-left:16px;padding-right:16px}}`;\n/opt/worm/changelog/index.js:5:const NETWORK_CSS = `.network-footer{position:fixed;left:50%;transform:translateX(-50%);width:min(100%,760px);z-index:7;display:flex;align-items:center;justi