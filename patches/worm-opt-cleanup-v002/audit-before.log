d rules=%d\" % (\n        firewall.get(\"id\"),\n        firewall.get(\"name\"),\n        len(applied),\n        len(firewall.get(\"rules\", [])),\n    ))\n\nprint(\"STORAGE=\")\nprint(\"  volumes=%d\" % len(volumes))\nprint(\"  snapshots=%d\" % len(snapshots))\nfor image in snapshots[:10]:\n    print(\"  - snapshot id=%s desc=%s created=%s\" % (\n        image.get(\"id\"),\n        image.get(\"description\"),\n        image.get(\"created\"),\n    ))\n\nif ip_type == \"FLOATING\":\n    print(\"MIRROR_STRATEGY=prepare API failover plan for Floating IP reassignment\")\nelse:\n    print(\"MIRROR_STRATEGY=robot public IP is not safely reassignable; mirror needs dedicated public IP\")\nPY\n# PATCH-INFRA-004-opnsense-hetzner-audit\n\nStatus: PASS\n\nScope:\n\n- Correct OPNsense health detection for `/api/status/network`.\n- Add read-only Hetzner audit tooling.\n- Document mirror/failover strategy.\n\nInfrastructure changes: NONE.\n\nCode changes:\n\n- `/opt/Android/dashboard/app/services/network_status.py`\n- `/opt/worm/control/api-status/README.md`\n- `/opt/worm/control/api-status/health-check.py`\n- `/opt/worm/changelog/timeline.json`\n\nThe previous OPNsense FAIL was caused by a rigid reachability probe to\n`https://10.60.0.1/` from worm-robot. That address is the worm-os WG\ngateway and is not a reliable control-plane probe from worm-robot. The\nprivate OPNsense endpoint responds on the private path, and HTTP 403 is\ntreated as valid service reachability because it proves the existing\nOPNsense service answered without requiring credentials.\n\nNo OPNsense, WireGuard, PF, NAT, DNS, FireHOL, route, public IP, private\nIP, or Hetzner infrastructure configuration was modified.\n","exit_code":0,"duration":{"secs":1,"nanos":297304919},"formatted_output":"from pathlib import Path\n\n\nBASE_DIR = Path(\"/opt/worm/control/dashboard\")\nDATA_DIR = BASE_DIR / \"data\"\nDB_PATH = DATA_DIR / \"dashboard.db\"\n\nGRAPHENE_DIR = Path(\"/opt/worm/build/grapheneos-frankel-17\")\nWORM_HOME_DIR = Path(\"/opt/worm\")\nWORM_OS_DIR = Path(\"/opt/worm/worm-os\")\nANDROID_ROOT = Path(\"/opt/worm\")\nKEYS_DIR = Path(\"/opt/Android/keys\")\n\nTARGET = \"frankel\"\nKERNEL = \"muzel\"\nROOT_PATH = \"\"\n\nBUILD_OUTPUT_DIR = GRAPHENE_DIR / \"out\" / \"target\" / \"product\" / TARGET\nDIST_DIR = GRAPHENE_DIR / \"out\" / \"dist\"\n\nLOG_CANDIDATES = [\n    GRAPHENE_DIR / \"out\" / \"verbose.log.gz\",\n    GRAPHENE_DIR / \"out\" / \"error.log\",\n    GRAPHENE_DIR / \"out\" / \"soong.log\",\n]\n\nSENSITIVE_PATTERNS = [\n    \"password\",\n    \"passwd\",\n    \"passphrase\",\n    \"secret\",\n    \"token\",\n    \"apikey\",\n    \"api_key\",\n    \"credential\",\n    \"private_key\",\n    \"signing_key\",\n]\n[Unit]\nDescription=Worm OS Antani build dashboard\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nWorkingDirectory=/opt/Android/dashboard\nEnvironment=PYTHONUNBUFFERED=1\nExecStart=/opt/Android/dashboard/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8765 --proxy-headers --forwarded-allow-ips=127.0.0.1\nRestart=on-failure\nRestartSec=5\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=strict\nProtectHome=true\nReadWritePaths=/opt/Android/dashboard/data\nReadOnlyPaths=/opt/Android/dashboard /opt/Android/grapheneos-frankel-17 /opt/Android/worm /opt/Android/worm-os\nInaccessiblePaths=/opt/Android/keys /root\n\n[Install]\nWantedBy=multi-user.target\n#!/bin/sh\nset -eu\n\nPATCH_DIR=/opt/worm/patches/PATCH-INFRA-004-opnsense-hetzner-audit\nOUT_DIR=\"$PATCH_DIR/audit-output\"\nTOKEN_FILE=/root/.config/hetzner/token\nmkdir -p \"$OUT_DIR\"\n\nmask_ipv4() {\n  python3 -c 'import re,sys; print(re.sub(r\"\\b\\d+\\.\\d+\\.\\d+\\.\\d+\\b\", \"[ipv4-redacted]\", sys.stdin.read()), end=\"\")'\n}\n\necho \"== network health ==\"\n/opt/Android/dashboard/.venv/bin/python /opt/worm/control/api-status/health-check.py || true\n\necho \"== local read-only state ==\"\n{\n  ip -br addr || true\n  ip route || true\n  wg show 2>/dev/null | awk 'BEGIN{IGNORECASE=1} /private key:/ {$0=\"  private key: (hidden)\"} {print}' || true\n} | mask_ipv4\n\nif [ ! -r \"$TOKEN_FILE\" ]; then\n  echo \"HETZNER_API=UNAVAILABLE\"\n  echo \"reason=token file not readable\"\n  exit 0\nfi\n\nTOKEN=$(tr -d '\\n\\r ' < \"$TOKEN_FILE\")\napi_get() {\n  path=\"$1\"\n  curl -fsS -H \"Authorization: Bearer ${TOKEN}\" \"https://api.hetzner.cloud/v1/${path}\"\n}\n\napi_get servers > /tmp/worm-hcloud-servers.json\napi_get networks > /tmp/worm-hcloud-networks.json\napi_get primary_ips > /tmp/worm-hcloud-primary-ips.json\napi_get floating_ips > /tmp/worm-hcloud-floating-ips.json\napi_get firewalls > /tmp/worm-hcloud-firewalls.json\napi_get volumes > /tmp/worm-hcloud-volumes.json\napi_get images?type=snapshot > /tmp/worm-hcloud-snapshots.json\n\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\n\nout = Path(\"/tmp\")\n\ndef load(name):\n    with (out / name).open() as handle:\n        return json.load(handle)\n\ndef mask_ip(value):\n    if not value:\n        return None\n    text = str(value)\n    if \".\" in text:\n        parts = text.split(\".\")\n        if len(parts) == 4:\n            return \".\".join(parts[:2] + [\"x\", \"x\"])\n    if \":\" in text:\n        return text.split(\":\")[0] + \":...:redacted\"\n    return text\n\nservers = load(\"worm-hcloud-servers.json\").get(\"servers\", [])\nprimary_ips = load(\"worm-hcloud-primary-ips.json\").get(\"primary_ips\", [])\nfloating_ips = load(\"worm-hcloud-floating-ips.json\").get(\"floating_ips\", [])\nnetworks = load(\"worm-hcloud-networks.json\").get(\"networks\", [])\nfirewalls = load(\"worm-hcloud-firewalls.json\").get(\"firewalls\", [])\nvolumes = load(\"worm-hcloud-volumes.json\").get(\"volumes\", [])\nsnapshots = load(\"worm-hcloud-snapshots.json\").get(\"images\", [])\n\nrobot = None\nfor server in servers:\n    name = server.get(\"name\", \"\").lower()\n    public = server.get(\"public_net\", {}).get(\"ipv4\", {}).get(\"ip\")\n    private_ips = [n.get(\"ip\") for n in server.get(\"private_net\", [])]\n    if \"robot\" in name or public == \"162.55.6.173\" or \"10.90.20.10\" in private_ips:\n        robot = server\n        break\n\nprint(\"HETZNER_API=PASS\")\nprint(\"SERVERS=\")\nfor server in servers:\n    print(\"  - id=%s name=%s status=%s location=%s datacenter=%s public4=%s\" % (\n        server.get(\"id\"),\n        server.get(\"name\"),\n        server.get(\"status\"),\n        server.get(\"public_net\", {}).get(\"ipv4\", {}).get(\"dns_ptr\") or server.get(\"location\", {}).get(\"name\"),\n        server.get(\"datacenter\", {}).get(\"name\"),\n        mask_ip(server.get(\"public_net\", {}).get(\"ipv4\", {}).get(\"ip\")),\n    ))\n\nrobot_id = robot.get(\"id\") if robot else None\nrobot_public = robot.get(\"public_net\", {}).get(\"ipv4\", {}).get(\"ip\") if robot else None\nrobot_primary = any(ip.get(\"server\") == robot_id and ip.get(\"ip\") == robot_public for ip in primary_ips)\nrobot_floating = any(ip.get(\"server\") == robot_id and ip.get(\"ip\") == robot_public for ip in floating_ips)\nif robot_floating:\n    ip_type = \"FLOATING\"\n    reassignable = \"YES\"\nelif robot_primary:\n    ip_type = \"PRIMARY\"\n    reassignable = \"NO\"\nelse:\n    ip_type = \"UNKNOWN\"\n    reassignable = \"NO\"\n\nprint(\"ROBOT=id=%s public=%s private=%s\" % (\n    robot_id,\n    mask_ip(robot_public),\n    \",\".join(mask_ip(n.get(\"ip\")) for n in (robot or {}).get(\"private_net\", [])),\n))\nprint(\"ROBOT_IP_TYPE=%s\" % ip_type)\nprint(\"ROBOT_IP_REASSIGNABLE=%s\" % reassignable)\n\nprint(\"PRIVATE_NETWORKS=\")\nfor network in networks:\n    print(\"  - id=%s name=%s range=%s routes=%d subnets=%d servers=%s\" % (\n        network.get(\"id\"),\n        network.get(\"name\"),\n        mask_ip(network.get(\"ip_range\")),\n        len(network.get(\"routes\", [])),\n        len(network.get(\"subnets\", [])),\n        \",\".join(str(item) for item in network.get(\"servers\", [])),\n    ))\n\nprint(\"FIREWALLS=\")\nfor firewall in firewalls:\n    applied = firewall.get(\"applied_to\", [])\n    print(\"  - id=%s name=%s applied_to=%d rules=%d\" % (\n        firewall.get(\"id\"),\n        firewall.get(\"name\"),\n        len(applied),\n        len(firewall.get(\"rules\", [])),\n    ))\n\nprint(\"STORAGE=\")\nprint(\"  volumes=%d\" % len(volumes))\nprint(\"  snapshots=%d\" % len(snapshots))\nfor image in snapshots[:10]:\n    print(\"  - snapshot id=%s desc=%s created=%s\" % (\n        image.get(\"id\"),\n        image.get(\"description\"),\n        image.get(\"created\"),\n    ))\n\nif ip_type == \"FLOATING\":\n    print(\"MIRROR_STRATEGY=prepare API failover plan for Floating IP reassignment\")\nelse:\n    print(\"MIRROR_STRATEGY=robot public IP is not safely reassignable; mirror needs dedicated public IP\")\nPY\n# PATCH-INFRA-004-opnsense-hetzner-audit\n\nStatus: PASS\n\nScope:\n\n- Correct OPNsense health detection for `/api/status/network`.\n- Add read-only Hetzner audit tooling.\n- Document mirror/failover strategy.\n\nInfrastructure changes: NONE.\n\nCode changes:\n\n- `/opt/Android/dashboard/app/services/network_status.py`\n- `/opt/worm/control/api-status/README.md`\n- `/opt/worm/control/api-status/health-check.py`\n- `/opt/worm/changelog/timeline.json`\n\nThe previous OPNsense FAIL was caused by a rigid reachability probe to\n`https://10.60.0.1/` from worm-robot. That address is the worm-os WG\ngateway and is not a reliable control-plane probe from worm-robot. The\nprivate OPNsense endpoint responds on the private path, and HTTP 403 is\ntreated as valid service reachability because it proves the existing\nOPNsense service answered without requiring credentials.\n\nNo OPNsense, WireGuard, PF, NAT, DNS, FireHOL, route, public IP, private\nIP, or Hetzner infrastructure configuration was modified.\n"},"started_at_ms":1788804829211,"completed_at_ms":1788804830509}}
