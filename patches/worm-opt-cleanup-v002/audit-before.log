   -p \"$STORAGE_PORT\" \\\n        -i \"$SSH_KEY\" \\\n        -o IdentitiesOnly=yes \\\n        \"${STORAGE_USER}@${STORAGE_HOST}\" \\\n        \"$@\"\n}\n\ntest_connection() {\n    [[ -f \"$SSH_KEY\" ]] || die \"Prima esegui: $0 init\"\n\n    log \"Test connessione Storage Box...\"\n\n    ssh \\\n        -p \"$STORAGE_PORT\" \\\n        -i \"$SSH_KEY\" \\\n        -o IdentitiesOnly=yes \\\n        -o BatchMode=yes \\\n        \"${STORAGE_USER}@${STORAGE_HOST}\" \\\n        \"ls worm-os\" >/dev/null\n\n    log \"Connessione SSH: OK\"\n}\n\nsetup_remote() {\n    log \"Creo struttura worm-os sullo Storage Box...\"\n\n    ssh_cmd \"\n        mkdir -p \\\n            ${REMOTE_ROOT}/ota/stable \\\n            ${REMOTE_ROOT}/ota/beta \\\n            ${REMOTE_ROOT}/builds \\\n            ${REMOTE_ROOT}/releases \\\n            ${REMOTE_ROOT}/manifests \\\n            ${REMOTE_ROOT}/backups\n    \"\n\n    log \"Struttura remota pronta.\"\n}\n\nupload() {\n    local src=\"${1:-}\"\n    local dst=\"${2:-releases}\"\n\n    [[ -n \"$src\" ]] || die \"Uso: $0 upload FILE [directory-remota]\"\n    [[ -e \"$src\" ]] || die \"File non trovato: $src\"\n\n    require scp\n\n    log \"Upload: $src -> ${REMOTE_ROOT}/${dst}/\"\n\n    scp \\\n        -P \"$STORAGE_PORT\" \\\n        -i \"$SSH_KEY\" \\\n        -o IdentitiesOnly=yes \\\n        \"$src\" \\\n        \"${STORAGE_USER}@${STORAGE_HOST}:${REMOTE_ROOT}/${dst}/\"\n\n    log \"Upload completato.\"\n}\n\nota() {\n    local file=\"${1:-}\"\n    local channel=\"${2:-beta}\"\n\n    [[ -n \"$file\" ]] || die \"Uso: $0 ota FILE.zip [beta|stable]\"\n    [[ -f \"$file\" ]] || die \"OTA non trovata: $file\"\n\n    case \"$channel\" in\n        beta|stable) ;;\n        *) die \"Canale non valido: $channel\" ;;\n    esac\n\n    require sha256sum\n    require scp\n\n    local name\n    local checksum\n\n    name=\"$(basename \"$file\")\"\n    checksum=\"${file}.sha256\"\n\n    sha256sum \"$file\" > \"$checksum\"\n\n    log \"Upload OTA ${channel}: ${name}\"\n\n    scp \\\n        -P \"$STORAGE_PORT\" \\\n        -i \"$SSH_KEY\" \\\n        -o IdentitiesOnly=yes \\\n        \"$file\" \\\n        \"$checksum\" \\\n        \"${STORAGE_USER}@${STORAGE_HOST}:${REMOTE_ROOT}/ota/${channel}/\"\n\n    log \"OTA caricata.\"\n    cat \"$checksum\"\n}\n\nsync_dir() {\n    local src=\"${1:-}\"\n    local dst=\"${2:-backups}\"\n\n    [[ -n \"$src\" ]] || die \"Uso: $0 sync DIRECTORY [directory-remota]\"\n    [[ -d \"$src\" ]] || die \"Directory non trovata: $src\"\n\n    require rsync\n\n    rsync \\\n        -av \\\n        --progress \\\n        -e \"ssh -p ${STORAGE_PORT} -i ${SSH_KEY} -o IdentitiesOnly=yes\" \\\n        \"${src%/}/\" \\\n        \"${STORAGE_USER}@${STORAGE_HOST}:${REMOTE_ROOT}/${dst}/\"\n}\n\nstatus() {\n    log \"Storage Box\"\n    echo \"Host:    ${STORAGE_HOST}\"\n    echo \"User:    ${STORAGE_USER}\"\n    echo \"Port:    ${STORAGE_PORT}\"\n    echo \"Root:    ${REMOTE_ROOT}\"\n    echo \"Key:     ${SSH_KEY}\"\n\n    if [[ -f \"$SSH_KEY\" ]]; then\n        echo \"SSH key: PRESENT\"\n    else\n        echo \"SSH key: NOT INITIALIZED\"\n    fi\n}\n\nusage() {\n    cat <<USAGE\nworm-os Storage Box\n\nUso:\n  $0 init\n  $0 test\n  $0 setup\n  $0 status\n\n  $0 upload FILE [remote-directory]\n  $0 ota FILE.zip [beta|stable]\n  $0 sync DIRECTORY [remote-directory]\n\nEsempi:\n  $0 init\n  $0 test\n  $0 setup\n\n  $0 ota worm-os-ota.zip beta\n  $0 ota worm-os-ota.zip stable\n\n  $0 upload manifest.json manifests\n  $0 sync /opt/worm/backups backups\nUSAGE\n}\n\ncase \"${1:-}\" in\n    init)\n        init_key\n        ;;\n    test)\n        test_connection\n","stderr":"","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\n# ============================================================\n# worm-os -> Hetzner Storage Box\n# ============================================================\n\nSTORAGE_HOST=\"u665326.your-storagebox.de\"\nSTORAGE_USER=\"u665326\"\nSTORAGE_PORT=\"23\"\n\nWORM_ROOT=\"