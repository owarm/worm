n","move_path":null},"/opt/worm/changelog/timeline.json":{"type":"update","unified_diff":"@@ -18,3 +18,5 @@\n         \"Treats an existing OPNsense HTTPS response on the private path as reachability instead of depending on ICMP or a single WireGuard address.\",\n-        \"Adds read-only Hetzner audit scripts that mask public addresses and do not print API tokens.\"\n+        \"Adds read-only Hetzner audit scripts that mask public addresses and do not print API tokens.\",\n+        \"Consolidates the worm.estixari.com control-plane runtime under /opt/worm/control/dashboard without deleting the historical /opt/Android/dashboard copy.\",\n+        \"Adds the About page WORM Network Architecture slot and keeps the footer status sourced only from /api/status/network.\"\n       ],\n@@ -27,3 +29,6 @@\n         \"patches/PATCH-INFRA-004-opnsense-hetzner-audit/revert.sh\",\n-        \"/opt/Android/dashboard/app/services/network_status.py\"\n+        \"control/dashboard/app/services/network_status.py\",\n+        \"control/dashboard/app/templates/about.html\",\n+        \"control/dashboard/public/assets/about/worm-network-architecture.png\",\n+        \"/etc/systemd/system/worm-dashboard.service\"\n       ],\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /etc/systemd/system/worm-dashboard.service\nM /opt/worm/control/dashboard/systemd/worm-dashboard.service\nM /opt/worm/control/api-status/health-check.py\nM /opt/worm/patches/PATCH-INFRA-004-opnsense-hetzner-audit/audit.sh\nM /opt/worm/patches/PATCH-INFRA-004-opnsense-hetzner-audit/verify.sh\nM /opt/worm/patches/PATCH-INFRA-004-opnsense-hetzner-audit/revert.sh\nM /opt/worm/patches/PATCH-INFRA-004-opnsense-hetzner-audit/README.md\nM /opt/worm/changelog/timeline.json\n","stderr":""},"started_at_ms":1788804862419,"completed_at_ms":1788804868262}}
