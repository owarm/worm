heneos-frankel-17/vendor/worm/WormSystemWireGuard/src/com/worm/systemwg/WormNetworkState.java\n/opt/Android/grapheneos-frankel-17/vendor/worm/WormSystemWireGuard/src/com/worm/systemwg/WormSystemWireGuardService.java\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a07f78-3e99-7e03-a9dd-f83b026f1b4e","create_time":1788844992.0763881}},{"type":"function_call_output","id":"fco_01a07f78-6654-7d02-859e-3d6ed17270fe","call_id":"call_mrmGP4UfF2UNDaPBTqAO8ZFy","output":"Chunk ID: 8f3ab6\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1525\nOutput:\npackage com.worm.systemwg;\n\nimport android.app.Notification;\nimport android.app.NotificationChannel;\nimport android.app.NotificationManager;\nimport android.content.Context;\nimport android.content.Intent;\nimport android.net.ConnectivityManager;\nimport android.net.Network;\nimport android.net.NetworkRequest;\nimport android.net.VpnManager;\nimport android.net.VpnService;\nimport android.os.Build;\nimport android.os.ParcelFileDescriptor;\nimport android.os.UserHandle;\nimport android.system.OsConstants;\nimport android.util.Log;\n\nimport java.io.IOException;\nimport java.lang.reflect.Method;\nimport java.util.Collections;\n\npublic final class WormSystemWireGuardService extends VpnService {\n    public static final String ACTION_START = \"com.worm.systemwg.START\";\n\n    private static final String TAG = \"WormSystemWG\";\n    private static final String CHANNEL_ID = \"worm_protected_network\";\n    private static final int NOTIFICATION_ID = 1060;\n\n    private ParcelFileDescriptor mTun;\n    private ConnectivityManager.NetworkCallback mNetworkCallback;\n    private WormNetworkState mState = WormNetworkState.BLOCKED;\n\n    public static void start(Context context) {\n        Intent intent = new Intent(context, WormSystemWireGuardService.class);\n        intent.setAction(ACTION_START);\n        context.startForegroundService(intent);\n    }\n\n    @Override\n    public void onCreate() {\n        super.onCreate();\n        createNotificationChannel();\n        startForeground(NOTIFICATION_ID, buildNotification());\n        enforceAlwaysOnLockdown();\n        registerNetworkCallback();\n        enterFailClosed(\"service created\");\n    }\n\n    @Override\n    public int onStartCommand(Intent intent, int flags, int startId) {\n        enforceAlwaysOnLockdown();\n        enterFailClosed(\"start command\");\n        return START_STICKY;\n    }\n\n    @Override\n    public void onDestroy() {\n        unregisterNetworkCallback();\n        closeTun();\n        super.onDestroy();\n    }\n\n    private void registerNetworkCallback() {\n        if (mNetworkCallback != null) {\n            return;\n        }\n        ConnectivityManager connectivityManager = getSystemService(ConnectivityManager.class);\n        if (connectivityManager == null) {\n            return;\n        }\n        mNetworkCallback = new ConnectivityManager.NetworkCallback() {\n            @Override\n            public void onAvailable(Network network) {\n                enterFailClosed(\"underlying network available\");\n            }\n\n            @Override\n            public void onLost(Network network) {\n                enterFailClosed(\"underlying network lost\");\n            }\n        };\n        connectivityManager.registerNetworkCallback(new NetworkRequest.Builder().build(), mNetworkCallback);\n    }\n\n    private void unregisterNetworkCallback() {\n        if (mNetworkCallback == null) {\n            return;\n        }\n        ConnectivityManager connectivityManager = getSystemService(ConnectivityManager.class);\n        if (connectivityManager != null) {\n            connectivityManager.unregisterNetworkCallback(mNetworkCallback);\n        }\n        mNetworkCallback = null;\n    }\n\n    private void enforceAlwaysOnLockdown() {\n        VpnManager vpnManager = getSystemService(VpnManager.class);\n        if (vpnManager == null) {\n            return;\n        }\n        try {\n            Method method = vpnManager.getClass().getMethod(\n                    \"setAlwaysOnVpnPackageForUser\",\n                    int.class,\n                    String.class,\n                    boolean.class,\n                    java.util.List.class);\n            method.invoke(vpnManager, UserHandle.myUserId(), getPackageName(), true,\n                    Collections.emptyList());\n        } catch (ReflectiveOperationException | RuntimeException e) {\n            Log.w(TAG, \"Unable to enforce always-on lockdown\", e);\n        }\n    }\n\n    private synchronized void enterFailClosed(String reason) {\n        mState = WormNetworkState.BLOCKED;\n        Builder builder = new Builder()\n                .setSession(\"Worm protected network\")\n                .addAddress(getString(R.string.worm_wg_client_address),\n                        getResources().getInteger(R.integer.worm_wg_client_prefix))\n                .addRoute(\"0.0.0.0\", 0)\n                .addRoute(\"::\", 0)\n                .addDnsServer(getString(R.string.worm_wg_dns))\n                .allowFamily(OsConstants.AF_INET)\n                .allowFamily(OsConstants.AF_INET6)\n                .setBlocking(true);\n\n        ParcelFileDescriptor nextTun = builder.establish();\n        if (nextTun == null) {\n            Log.w(TAG, \"Fail-closed VPN establish returned null: \" + reason);\n            return;\n        }\n        closeTun();\n        mTun = nextTun;\n        Log.i(TAG, \"WORM_NETWORK_BLOCKED: \" + reason);\n    }\n\n    private synchronized void closeTun() {\n        if (mTun == null) {\n            return;\n        }\n        try {\n            mTun.close();\n        } catch (IOException e) {\n            Log.w(TAG, \"Failed to close TUN\", e);\n        }\n        mTun = null;\n    }\n\n    private void createNotificationChannel() {\n        NotificationManager notificationManager = getSystemService(NotificationManager.class);\n        if (notificationManager == null) {\n            return;\n        }\n        notificationManager.createNotificationChannel(new NotificationChannel(\n                CHANNEL_ID,\n                getString(R.string.notification_channel),\n                NotificationManager.IMPORTANCE_LOW));\n    }\n\n    private Notification buildNotification() {\n        Notification.Builder builder = new Notification.Builder(this, CHANNEL_ID)\n                .setContentTitle(getString(R.string.app_name))\n                .setContentText(getString(R.string.notification_blocked))\n                .setSmallIcon(android.R.drawable.stat_sys_warning)\n                .setOngoing(true)\n                .setShowWhen(false);\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n            builder.setForegroundServiceBehavior(Notification.FOREGROUND_SERVICE_IMMEDIATE);\n        }\n        return builder.build();\n    }\n}\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a07f78-3e99-7e03-a9dd-f83b026f1b4e","create_time":1788844992.0848522}},{"type":"function_call_output","id":"fco_01a07f78-6673-7683-9b71-0a9f92ef697f","call_id":"call_q4TLsEVEzTCvneNR2qx1oCxf","output":"Chunk ID: b3ab13\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 465\nOutput:\n<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    package=\"com.worm.systemwg\">\n    <uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>\n    <uses-permission android:name=\"android.permission.CONTROL_ALWAYS_ON_VPN\"/>\n    <uses-permission android:name=\"android.permission.FOREGROUND_SERVICE\"/>\n    <uses-permission android:name=\"android.permission.FOREGROUND_SERVICE_SPECIAL_USE\"/>\n    <uses-permission android:name=\"android.permission.RECEIVE_BOOT_COMPLETED\"/>\n\n    <application\n        android:allowBackup=\"false\"\n        android:directBootAware=\"true\"\n        android:label=\"@string/app_name\"\n        android:usesC