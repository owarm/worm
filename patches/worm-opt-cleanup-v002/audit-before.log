ildNotification());\n        enforceAlwaysOnLockdown();\n        registerNetworkCallback();\n        startProtectedTunnelOrFailClosed(\"service created\");\n    }\n\n    @Override\n    public int onStartCommand(Intent intent, int flags, int startId) {\n        enforceAlwaysOnLockdown();\n        startProtectedTunnelOrFailClosed(\"start command\");\n        return START_STICKY;\n    }\n\n    @Override\n    public void onDestroy() {\n        unregisterNetworkCallback();\n        mBackend.stop();\n        closeTun();\n        super.onDestroy();\n    }\n\n    @Override\n    public void onRevoke() {\n        enforceAlwaysOnLockdown();\n        enterFailClosed(\"vpn revoked\");\n    }\n\n    private void registerNetworkCallback() {\n        if (mNetworkCallback != null) {\n            return;\n        }\n        ConnectivityManager connectivityManager = getSystemService(ConnectivityManager.class);\n        if (connectivityManager == null) {\n            return;\n        }\n        mNetworkCallback = new ConnectivityManager.NetworkCallback() {\n            @Override\n            public void onAvailable(Network network) {\n                startProtectedTunnelOrFailClosed(\"underlying network available\");\n            }\n\n            @Override\n            public void onLost(Network network) {\n                mBackend.stop();\n                enterFailClosed(\"underlying network lost\");\n            }\n        };\n        connectivityManager.registerNetworkCallback(new NetworkRequest.Builder().build(), mNetworkCallback);\n    }\n\n    private void unregisterNetworkCallback() {\n        if (mNetworkCallback == null) {\n            return;\n        }\n        ConnectivityManager connectivityManager = getSystemService(ConnectivityManager.class);\n        if (connectivityManager != null) {\n            connectivityManager.unregisterNetworkCallback(mNetworkCallback);\n        }\n        mNetworkCallback = null;\n    }\n\n    private void enforceAlwaysOnLockdown() {\n        VpnManager vpnManager = getSystemService(VpnManager.class);\n        if (vpnManager == null) {\n            return;\n        }\n        try {\n            Method method = vpnManager.getClass().getMethod(\n                    \"setAlwaysOnVpnPackageForUser\",\n                    int.class,\n                    String.class,\n                    boolean.class,\n                    java.util.List.class);\n            method.invoke(vpnManager, UserHandle.myUserId(), getPackageName(), true,\n                    Collections.emptyList());\n        } catch (ReflectiveOperationException | RuntimeException e) {\n            Log.w(TAG, \"Unable to enforce always-on lockdown\", e);\n        }\n    }\n\n    private synchronized void enterFailClosed(String reason) {\n        mBackend.stop();\n        mState = WormNetworkState.BLOCKED;\n        Builder builder = baseBuilder()\n                .setSession(\"Worm protected network\")\n                .setBlocking(true);\n\n        ParcelFileDescriptor nextTun = builder.establish();\n        if (nextTun == null) {\n            Log.w(TAG, \"Fail-closed VPN establish returned null: \" + reason);\n            return;\n        }\n        closeTun();\n        mTun = nextTun;\n        Log.i(TAG, \"WORM_NETWORK_BLOCKED: \" + reason);\n    }\n\n    private synchronized void startProtectedTunnelOrFailClosed(String reason) {\n        Builder builder = baseBuilder()\n                .setSession(\"Worm protected network\")\n                .setBlocking(true);\n\n        ParcelFileDescriptor nextTun = builder.establish();\n        if (nextTun == null) {\n            enterFailClosed(\"protected VPN establish returned null: \" + reason);\n            return;\n        }\n\n        try {\n            mBackend.start(\n                    this,\n                    nextTun,\n                    createDeviceProtectedStorageContext().getFilesDir(),\n                    \"worm0\",\n                    getString(R.string.worm_wg_endpoint_host),\n                    getResources().getInteger(R.integer.worm_wg_endpoint_port),\n                    getString(R.string.worm_wg_server_public_key),\n                    getResources().getInteger(R.integer.worm_wg_keepalive_seconds));\n            closeTun();\n            mTun = null;\n            mState = WormNetworkState.PROTECTED;\n            Log.i(TAG, \"WORM_NETWORK_PROTECTED using wireguard-go \" + mBackend.getVersion());\n        } catch (IOException | RuntimeException e) {\n            try {\n                nextTun.close();\n            } catch (IOException closeException) {\n                Log.w(TAG, \"Failed to close failed TUN\", closeException);\n            }\n            Log.w(TAG, \"Unable to start Worm WireGuard backend\", e);\n            enterFailClosed(\"backend start failed: \" + reason);\n        }\n    }\n\n    private Builder baseBuilder() {\n        return new Builder()\n                .addAddress(getString(R.string.worm_wg_client_address),\n                        getResources().getInteger(R.integer.worm_wg_client_prefix))\n                .addRoute(\"0.0.0.0\", 0)\n                .addRoute(\"::\", 0)\n                .addDnsServer(getString(R.string.worm_wg_dns))\n                .allowFamily(OsConstants.AF_INET)\n                .allowFamily(OsConstants.AF_INET6)\n                .setMtu(1280);\n    }\n\n    private synchronized void closeTun() {\n        if (mTun == null) {\n            return;\n        }\n        try {\n            mTun.close();\n        } catch (IOException e) {\n            Log.w(TAG, \"Failed to close TUN\", e);\n        }\n        mTun = null;\n    }\n\n    private void createNotificationChannel() {\n        NotificationManager notificationManager = getSystemService(NotificationManager.class);\n        if (notificationManager == null) {\n            return;\n        }\n        notificationManager.createNotificationChannel(new NotificationChannel(\n                CHANNEL_ID,\n                getString(R.string.notification_channel),\n                NotificationManager.IMPORTANCE_LOW));\n    }\n\n    private Notification buildNotification() {\n        Notification.Builder builder = new Notification.Builder(this, CHANNEL_ID)\n                .setContentTitle(getString(R.string.app_name))\n                .setContentText(getString(R.string.notification_blocked))\n                .setSmallIcon(android.R.drawable.stat_sys_warning)\n                .setOngoing(true)\n                .setShowWhen(false);\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {\n            builder.setForegroundServiceBehavior(Notification.FOREGROUND_SERVICE_IMMEDIATE);\n        }\n        return builder.build();\n    }\n}\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a07f9a-4db3-7512-bae2-e83dc8203e75","create_time":1788851174.8642585}},{"type":"function_call_output","id":"fco_01a07fd6-bdd3-7a11-9564-2c8f04c810dc","call_id":"call_NJBwovedhDBRFOL8aqFdqbw5","output":"Chunk ID: cf3f80\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 227\nOutput:\npackage {\n    default_applicable_licenses: [\"external_wireguard-worm_license\"],\n}\n\nlicense {\n    name: \"external_wireguard-worm_license\",\n    visibility: [\":__subpackages__\"],\n    license_kinds: [\"SPDX-license-identifier-Apache-2.0\"],\n    license_text: [\n        \"COPYING.wireguard-android\",\n        \"LICENSE.wireguard-go\",\n    ],\n}\n\nsh_binary_host {\n    name: \"worm-build-libwg-go\",\n    src: \"build-libwg-go.sh\",\n}\n\ngenrule {\n    name: \"worm-libwg-go-source-built\",\n    tools: [\"worm-build-libwg-go\"],\n    srcs: [\n        \"libwg-go/**/*.c\",\n        \"libwg-go/**/*.go\",\n        \"libwg-go/go.mod\",\n        \"libwg-go/go.sum\",\n        \"libwg-go/vendor/**/*\",\n    ],\n    out: [\"libwg-go.so\"],\n    cmd: \"$(location worm-build-libwg-go) $(genDir) $(out)\",\n}\n\ncc_prebuilt_library_shared {\n    name: \"libwg-go\",\n    srcs: [\":worm-libwg-go-source-built\"],\n    compi