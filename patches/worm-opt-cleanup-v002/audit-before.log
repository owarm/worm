ho \\\"ANDROID_BUILD_TOP=$ANDROID_BUILD_TOP\\\" | tee -a \\\"$log\\\"' 'echo \\\"OUT_DIR=$OUT_DIR\\\" | tee -a \\\"$log\\\"' 'echo \\\"TMPDIR=$TMPDIR\\\" | tee -a \\\"$log\\\"' 'echo \\\"CCACHE_DIR=$CCACHE_DIR\\\" | tee -a \\\"$log\\\"' 'echo \\\"TARGETS=$*\\\" | tee -a \\\"$log\\\"' '' 'm \\\"$@\\\" 2>&1 | tee -a \\\"$log\\\"' > /opt/worm/scripts/build/worm-build.sh\\nchmod 0755 /opt/worm/scripts/build/worm-build.sh\\nprintf '%s\\\\n' '#!/usr/bin/env bash' 'set -euo pipefail' '' 'WORM_ROOT=/opt/worm' '' 'usage() {' '  echo \\\"usage: $0 <logs|tmp|out|ota|target-files|cache>\\\" >&2' '}' '' 'if [ \\\"$#\\\" -ne 1 ]; then' '  usage' '  exit 2' 'fi' '' 'case \\\"$1\\\" in' '  logs)' '    find \\\"$WORM_ROOT/build/logs\\\" -type f -mtime +14 -print -delete' '    ;;' '  tmp)' '    find \\\"$WORM_ROOT/build/tmp\\\" -mindepth 1 -print -exec rm -rf {} +' '    ;;' '  out)' '    find \\\"$WORM_ROOT/build/out\\\" -mindepth 1 -print -exec rm -rf {} +' '    ;;' '  ota)' '    find \\\"$WORM_ROOT/build/ota\\\" -mindepth 1 -print -exec rm -rf {} +' '    ;;' '  target-files)' '    find \\\"$WORM_ROOT/build/target-files\\\" -mindepth 1 -print -exec rm -rf {} +' '    ;;' '  cache)' '    find \\\"$WORM_ROOT/cache/downloads\\\" -mindepth 1 -print -exec rm -rf {} +' '    ;;' '  *)' '    usage' '    exit 2' '    ;;' 'esac' > /opt/worm/scripts/maintenance/worm-clean.sh\\nchmod 0755 /opt/worm/scripts/maintenance/worm-clean.sh\\nprintf '%s\\\\n' '#!/usr/bin/env bash' 'set -euo pipefail' '' 'WORM_ROOT=/opt/worm' '' 'echo \\\"== filesystem ==\\\"' 'df -h \\\"$WORM_ROOT\\\"' 'echo' 'echo \\\"== inodes ==\\\"' 'df -i \\\"$WORM_ROOT\\\"' 'echo' 'echo \\\"== canonical areas ==\\\"' 'du -xsh \\\"$WORM_ROOT/src\\\" \\\"$WORM_ROOT/build\\\" \\\"$WORM_ROOT/cache\\\" \\\"$WORM_ROOT/artifacts\\\" 2>/dev/null || true' 'echo' 'echo \\\"== largest directories ==\\\"' 'du -xhd2 \\\"$WORM_ROOT\\\" 2>/dev/null | sort -h | tail -40' > /opt/worm/scripts/maintenance/worm-disk.sh\\nchmod 0755 /opt/worm/scripts/m