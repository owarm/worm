:92,\"apks\":[\"base.apk\"],\"apkHashes\":[\"f54d47ae7f57871906020d5dc1c32ef44913ca18cf79a6771d812a9c9e012bca\"],\"apkSizes\":[3141714],\"apkGzSizes\":[1375744],\"apkBrSizes\":[1188927],\"versionName\":\"92\",\"minSdk\":33,\"label\":\"Auditor\",\"channel\":\"stable\",\"hasV4Signatures\":true,\"abis\":[\"arm64-v8a\",\"armeabi-v7a\",\"x86\",\"x86_64\"]}}},\"app.grapheneos.AppCompatConfig\":{\"signatures\":[\"e5044303e85b4cceaae00ecf8823c9c6f937a8e3a2fb632ec9fa45b2c33b4bd1\"],\"source\":\"GrapheneOS\",\"hasFsVeritySignatures\":true,\"isTopLevel\":false,\"noCode\":true,\"staticDeps\":[\"app.grapheneos.AppCompatConfig >= 1\"],\"description\":\"<p>AppCompatConfig is a part of GrapheneOS. It's a file that specifies compatibility of some apps\\nwith the optional GrapheneOS per-app exploit protection features, which allows to automatically\\nenable or disable them by default.</p>\\n\\n<p>The main purpose of AppCompatConfig is to enable additional exploit protections for popular apps\\nthat are known to be compatible with them.</p>\\n\\n<p>Automatic disabling of exploit protection features can be turned off via <b>Settings&nbsp;>\\nSecurity&nbsp;> Automatic exploit protection compatibility mode</b> toggle.</p>\\n\",\"variants\":{\"8\":{\"versionCode\":8,\"apks\":[\"base.apk\"],\"apkHashes\":[\"992839e93d11e1c0e8446a34f8e36528933094420fedc259e45e6b4d1c580b53\"],\"apkSizes\":[20500],\"apkGzSizes\":[17028],\"apkBrSizes\":[16798],\"versionName\":\"8\",\"minSdk\":34,\"label\":\"AppCompatConfig\",\"channel\":\"stable\",\"hasV4Signatures\":true}}},\"app.grapheneos.camera\":{\"signatures\":[\"6436b155b917c2f9a9ed1d15c4993a5968ffabc94947c13f2aeee14b7b27ed59\"],\"source\":\"GrapheneOS\",\"hasFsVeritySignatures\":true,\"description\":\"A modern camera app focused on privacy and security. It includes modes for capturing images, videos and QR / barcode scanning along with additional modes based on CameraX vendor extensions (Portrait, HDR, Night, Face Retouch and Auto) on devices where they're available.\\n\",\"iconType\":\"webp\",\"variants\":{\"93\":{\"versionCode\":93,\"apks\":[\"base.apk\"],\"apkHashes\":[\"6e1d05a7b96b308f3a9dff3103db55cfee2cbea38b3249b5879fe35cfcf179ff\"],\"apkSizes\":[3931896],\"apkGzSizes\":[1807400],\"apkBrSizes\":[1552089],\"versionName\":\"93\",\"minSdk\":29,\"label\":\"Camera\",\"channel\":\"stable\",\"hasV4Signatures\":true,\"abis\":[\"arm64-v8a\",\"armeabi-v7a\",\"x86\",\"x86_64\"]}}},\"app.grapheneos.gmscompat.config\":{\"signatures\":[\"6ebb65c5daa95641f7a774ea35d26ff251575cb32e34a8a5d655b2742b57321f\"],\"source\":\"GrapheneOS\",\"hasFsVeritySignatures\":true,\"isTopLevel\":false,\"noCode\":true,\"packagesAllowedToTriggerUpdate\":[\"app.grapheneos.gmscompat\"],\"staticDeps\":[\"app.grapheneos.gmscompat >= 1000\"],\"description\":\"GmsCompatConfig is a configuration file for the sandboxed Google Play compatibility layer.\\n\\nSandboxed Google Play compatibility layer (GmsCompat) and GmsCompatConfig are parts of GrapheneOS.\\n\",\"variants\":{\"173\":{\"versionCode\":173,\"apks\":[\"base.apk\"],\"apkHashes\":[\"3c1d3cdb26a9a61071d07ca452a337a01c68a5679ac5432ce0dae8d26b15a4a6\"],\"apkSizes\":[24239],\"apkGzSizes\":[20786],\"apkBrSizes\":[20545],\"versionName\":\"173\",\"minSdk\":32,\"label\":\"GmsCompatConfig\",\"channel\":\"stable\",\"hasV4Signatures\":true}}},\"app.grapheneos.gmscompat.lib\":{\"signatures\":[\"cb3687797edbb8a28631eb725b650a8b4a5879ea47e6220a35cef157c9829429\"],\"source\":\"GrapheneOS\",\"hasFsVeritySignatures\":true,\"isTopLevel\":false,\"description\":\"GmsCompatLib is a part of the GrapheneOS sandboxed Google Play compatibility layer.\\n\",\"variants\":{}},\"app.grapheneos.info\":{\"signatures\":[\"d7168c60f491ee3bb300c559e8c6d4a050df4791edf1b3c1786731a6fa999d1a\"],\"source\":\"GrapheneOS\",\"hasFsVeritySignatures\":true,\"description\":\"Info is a minimal app through which you can get information about the latest releases of GrapheneOS, links to our community spaces, and details on how to make donat