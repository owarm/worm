nnel}: ${name}\"\n\n    scp \\\n        -P \"$STORAGE_PORT\" \\\n        -i \"$SSH_KEY\" \\\n        -o IdentitiesOnly=yes \\\n        \"$file\" \\\n        \"$checksum\" \\\n        \"${STORAGE_USER}@${STORAGE_HOST}:${REMOTE_ROOT}/ota/${channel}/\"\n\n    log \"OTA caricata.\"\n    cat \"$checksum\"\n}\n\nsync_dir() {\n    local src=\"${1:-}\"\n    local dst=\"${2:-backups}\"\n\n    [[ -n \"$src\" ]] || die \"Uso: $0 sync DIRECTORY [directory-remota]\"\n    [[ -d \"$src\" ]] || die \"Directory non trovata: $src\"\n\n    require rsync\n\n    rsync \\\n        -av \\\n        --progress \\\n        -e \"ssh -p ${STORAGE_PORT} -i ${SSH_KEY} -o IdentitiesOnly=yes\" \\\n        \"${src%/}/\" \\\n        \"${STORAGE_USER}@${STORAGE_HOST}:${REMOTE_ROOT}/${dst}/\"\n}\n\nstatus() {\n    log \"Storage Box\"\n    echo \"Host:    ${STORAGE_HOST}\"\n    echo \"User:    ${STORAGE_USER}\"\n    echo \"Port:    ${STORAGE_PORT}\"\n    echo \"Root:    ${REMOTE_ROOT}\"\n    echo \"Key:     ${SSH_KEY}\"\n\n    if [[ -f \"$SSH_KEY\" ]]; then\n        echo \"SSH key: PRESENT\"\n    else\n        echo \"SSH key: NOT INITIALIZED\"\n    fi\n}\n\nusage() {\n    cat <<USAGE\nworm-os Storage Box\n\nUso:\n  $0 init\n  $0 test\n  $0 setup\n  $0 status\n\n  $0 upload FILE [remote-directory]\n  $0 ota FILE.zip [beta|stable]\n  $0 sync DIRECTORY [remote-directory]\n\nEsempi:\n  $0 init\n  $0 test\n  $0 setup\n\n  $0 ota worm-os-ota.zip beta\n  $0 ota worm-os-ota.zip stable\n\n  $0 upload manifest.json manifests\n  $0 sync /opt/worm/backups backups\nUSAGE\n}\n\ncase \"${1:-}\" in\n    init)\n        init_key\n        ;;\n    test)\n        test_connection\n"},"started_at_ms":1788886293314,"completed_at_ms":1788886293315}}
