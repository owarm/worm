int wgGetSocketV6(int handle);\n    private static native String wgGetConfig(int handle);\n    private static native String wgVersion();\n\n    public synchronized String getVersion() {\n        return wgVersion();\n    }\n\n    public synchronized String getRuntimeConfig() {\n        if (mHandle < 0) {\n            return \"\";\n        }\n        String config = wgGetConfig(mHandle);\n        return config == null ? \"\" : config;\n    }\n\n    public synchronized void start(\n            VpnService service,\n            ParcelFileDescriptor tun,\n            File privateStorageDir,\n            String interfaceName,\n            String endpointHost,\n            int endpointPort,\n            String serverPublicKey,\n            int keepaliveSeconds) throws IOException {\n        if (mHandle >= 0) {\n            stop();\n        }\n\n        String settings = buildUserspaceSettings(\n                privateStorageDir, endpointHost, endpointPort, serverPublicKey, keepaliveSeconds);\n        int fd = tun.detachFd();\n        int handle = wgTurnOn(interfaceName, fd, settings);\n        if (handle < 0) {\n            throw new IOException(\"wireguard-go activation failed: \" + handle);\n        }\n        mHandle = handle;\n\n        protectSocket(service, wgGetSocketV4(mHandle), \"v4\");\n        protectSocket(service, wgGetSocketV6(mHandle), \"v6\");\n        Log.i(TAG, \"WireGuard backend started\");\n    }\n\n    public synchronized void stop() {\n        if (mHandle < 0) {\n            return;\n        }\n        int handle = mHandle;\n        mHandle = -1;\n        wgTurnOff(handle);\n        Log.i(TAG, \"WireGuard backend stopped\");\n    }\n\n    private static void protectSocket(VpnService service, int socket, String family)\n            throws IOException {\n        if (socket < 0) {\n            Log.i(TAG, \"No WireGuard \" + family + \" transport socket to protect\");\n            return;\n        }\n        if (!service.protect(socket)) {\n            throw new IOException(\"failed to protect WireGuard \" + family + \" transport socket\");\n        }\n    }\n\n    private static String buildUserspaceSettings(\n            File privateStorageDir,\n            String endpointHost,\n            int endpointPort,\n            String serverPublicKey,\n            int keepaliveSeconds) throws IOException {\n        String privateKeyHex = readPrivateKeyHex(privateStorageDir);\n        String serverPublicKeyHex = keyToHex(serverPublicKey);\n        return \"private_key=\" + privateKeyHex + \"\\n\"\n                + \"replace_peers=true\\n\"\n                + \"public_key=\" + serverPublicKeyHex + \"\\n\"\n                + \"endpoint=\" + endpointHost + \":\" + endpointPort + \"\\n\"\n                + \"allowed_ip=0.0.0.0/0\\n\"\n                + \"persistent_keepalive_interval=\" + keepaliveSeconds + \"\\n\";\n    }\n\n    private static String readPrivateKeyHex(File privateStorageDir) throws IOException {\n        Path privateKeyPath = privateStorageDir.toPath().resolve(PRIVATE_KEY_RELATIVE_PATH);\n        String key = Files.readString(privateKeyPath, StandardCharsets.US_ASCII).trim();\n        if (key.matches(\"[0-9a-fA-F]{64}\")) {\n            return key.toLowerCase(Locale.ROOT);\n        }\n        return keyToHex(key);\n    }\n\n    private static String keyToHex(String key) throws IOException {\n        byte[] decoded;\n        try {\n            decoded = Base64.decode(key, Base64.NO_WRAP);\n        } catch (IllegalArgumentException e) {\n            throw new IOException(\"invalid WireGuard key encoding\", e);\n        }\n        if (decoded.length != 32) {\n            throw new IOException(\"invalid WireGuard key length\");\n        }\n        StringBuilder builder = new StringBuilder(decoded.length * 2);\n        for (byte b : decoded) {\n            builder.append(String.format(Locale.ROOT, \"%02x\", b & 0xff));\n        }\n        return builder.toString();\n    }\n}\n","internal_chat_message_metadata_pa