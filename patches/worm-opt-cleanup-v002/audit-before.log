ing.\\n\",\"variants\":{\"1\":{\"versionCode\":1,\"apks\":[\"base.apk\"],\"apkHashes\":[\"b51ca6efb9c5af95fa9ddb53f737592b0acd8ab9e1e3f95fff04060a1464588f\"],\"apkSizes\":[161601974],\"apkGzSizes\":[85089677],\"apkBrSizes\":[66017062],\"versionName\":\"1\",\"minSdk\":36,\"label\":\"GrapheneOS Speech Services\",\"channel\":\"stable\",\"hasV4Signatures\":true,\"abis\":[\"arm64-v8a\",\"armeabi-v7a\",\"x86\",\"x86_64\"]},\"3\":{\"versionCode\":3,\"apks\":[\"base.apk\"],\"apkHashes\":[\"cacbe72f4ac05e30cb874947513cbd6702faa7aea49615100cfdaee0b0ad056c\"],\"apkSizes\":[75506283],\"apkGzSizes\":[52855159],\"apkBrSizes\":[42916658],\"versionName\":\"3\",\"minSdk\":36,\"label\":\"GrapheneOS Speech Services\",\"channel\":\"stable\",\"hasV4Signatures\":true,\"abis\":[\"arm64-v8a\"]}}},\"app.vanadium.browser\":{\"signatures\":[\"c6adb8b83c6d4c17d292afde56fd488a51d316ff8f2c11c5410223bff8a7dbb3\"],\"source\":\"GrapheneOS\",\"hasFsVeritySignatures\":true,\"group\":\"Vanadium\",\"originalPackage\":\"org.chromium.chrome\",\"deps2\":[\"app.vanadium.trichromelibrary\",\"app.vanadium.config 0 SkipIfMissing\"],\"deps\":[\"app.vanadium.trichromelibrary\"],\"staticDeps\":[\"app.vanadium.browser >= 548106100\",\"app.grapheneos.apps >= 22\"],\"description\":\"Vanadium is a privacy and security hardened variant of Chromium providing the WebView (used by other apps to render web content) and standard browser for GrapheneOS. It depends on hardening and compatibility fixes in GrapheneOS rather than reinventing the wheel inside Vanadium. For example, GrapheneOS already provides a hardened malloc implementation so there's no need for Vanadium to replace it. Similarly, it can deploy security features causing breakage on other operating systems due to the ability to fix compatibility problems in the OS.\\n\",\"iconType\":\"webp\",\"variants\":{\"797706433\":{\"versionCode\":797706433,\"apks\":[\"base.apk\"],\"apkHashes\":[\"7ee7168ab510141f2c000d2bc98ba4999b7a1a881245094c26e964e91a967560\"],\"apkSiz