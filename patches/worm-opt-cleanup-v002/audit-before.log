x.js:7:const NETWORK_SCRIPT = `const footer=document.getElementById('network-footer');if(footer){const button=document.getElementById('network-footer-button');const glyph=document.getElementById('network-footer-glyph');const popover=document.getElementById('network-footer-popover');const stateNode=document.getElementById('network-footer-state');const setState=(payload)=>{const state=String(payload&&payload.status||'offline').toLowerCase();const operational=state==='operational';const wireguard=payload&&payload.wireguard===true;const opnsense=payload&&payload.opnsense===true;const interfaceName=payload&&payload.interface||'unknown';const lastCheck=payload&&payload.last_check?new Date(payload.last_check).toLocaleString():'unknown';const handshakeRecent=payload&&payload.handshake_recent===true;const handshakeAge=Number.isFinite(Number(payload&&payload.handshake_age_seconds))?Math.round(Number(payload.handshake_age_seconds)/60)+' min':'unknown';const routePresent=payload&&payload.route_present===true;const reachability=payload&&payload.opnsense_reachable===true;footer.dataset.state=operational?'operational':'offline';if(glyph){glyph.classList.toggle('is-operational',operational);glyph.classList.toggle('is-offline',!operational)}if(button){button.title=operational?'Operational':'Offline';button.setAttribute('aria-label',operational?'Operational network status':'Offline network status')}if(stateNode){stateNode.textContent=operational?'Operational':'Offline'}if(popover){popover.querySelector('[data-field=\\\"last_check\\\"]').textContent=lastCheck;popover.querySelector('[data-field=\\\"wireguard\\\"]').textContent=wireguard?'Up':'Down';popover.querySelector('[data-field=\\\"interface\\\"]').textContent=interfaceName;popover.querySelector('[data-field=\\\"handshake\\\"]').textContent=handshakeRecent?'Recent':'Stale ('+handshakeAge+')';popover.querySelector('[data-field=\\\"route\\\"]').textContent=routePresent?'Present':'Missing';popover.querySelector('[data-field=\\\"opnse