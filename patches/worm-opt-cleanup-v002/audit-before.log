KPOINTS\" \"$SNAPSHOTS\" \"$LOGS\" \"$TMP\" \\\n        \"$CACHE\" \"$CACHE/gradle\" \"$CACHE/projectctl\"\n}\n\ndiscover_java() {\n    if [[ -n \"${JAVA_HOME:-}\" && -x \"$JAVA_HOME/bin/java\" ]]; then\n        export PATH=\"$JAVA_HOME/bin:$PATH\"\n        return\n    fi\n    if command -v java >/dev/null 2>&1; then\n        local java_path\n        java_path=\"$(readlink -f \"$(command -v java)\")\"\n        export JAVA_HOME=\"${java_path%/bin/java}\"\n        export PATH=\"$JAVA_HOME/bin:$PATH\"\n        return\n    fi\n    local java_path\n    java_path=\"$(find /usr/lib/jvm -type f -path '*/bin/java' -executable -print 2>/dev/null | sort -V | tail -1)\"\n    [[ -n \"$java_path\" ]] || { echo \"ERROR: Java/JDK not found\" >&2; return 1; }\n    export JAVA_HOME=\"${java_path%/bin/java}\"\n    export PATH=\"$JAVA_HOME/bin:$PATH\"\n}\n\nsdk_dir() {\n    if [[ -n \"${ANDROID_HOME:-}\" && -d \"$ANDROID_HOME\" ]]; then\n        printf '%s\\n' \"$ANDROID_HOME\"\n        return\n    fi\n    if [[ -n \"${ANDROID_SDK_ROOT:-}\" && -d \"$ANDROID_SDK_ROOT\" ]]; then\n        printf '%s\\n' \"$ANDROID_SDK_ROOT\"\n        return\n    fi\n    if [[ -f \"$PROJECT/local.properties\" ]]; then\n        local sdk\n        sdk=\"$(grep -E '^sdk\\.dir=' \"$PROJECT/local.properties\" | head -1 | cut -d= -f2-)\"\n        if [[ -n \"${sdk:-}\" && -d \"$sdk\" ]]; then\n            printf '%s\\n' \"$sdk\"\n            return\n        fi\n    fi\n    printf '%s\\n' \"$ANDROID_SDK_DEFAULT\"\n}\n\nunique_id() {\n    local base=\"$1\"\n    local candidate=\"$base\"\n    local suffix=1\n    while [[ -e \"$OUTPUTS/$candidate\" || -e \"$SNAPSHOTS/$candidate\" || -e \"$CHECKPOINTS/$candidate\" ]]; do\n        candidate=\"${base}-$(printf '%02d' \"$suffix\")\"\n        suffix=$((suffix + 1))\n    done\n    printf '%s\\n' \"$candidate\"\n}\n\natomic_latest() {\n    local parent=\"$1\" target=\"$2\"\n    local tmp_link=\"$parent/.latest.$$\"\n    ln -s \"$target\" \"$tmp_link\"\n    mv -Tf \"$tmp_link\" \"$parent/latest\"\n}\n\nsnapshot_source() {\n    local dir=\"$1\"\n    install -d -m 0755 \"$dir\"\n    tar -C \"$PROJECT\" -czf \"$dir/project.tar.gz\" \\\n        --exclude='./.git' \\\n        --exclude='./.gradle' \\\n        --exclude='./.kotlin' \\\n        --exclude='./.idea' \\\n        --exclude='./build' \\\n        --exclude='./app/build' \\\n        --exclude='./local.properties' \\\n        --exclude='./outputs' \\\n        --exclude='./snapshots' \\\n        --exclude='./checkpoints' \\\n        --exclude='./logs' \\\n        --exclude='./tmp' \\\n        .\n    (cd \"$dir\" && sha256sum project.tar.gz > SHA256SUMS.txt)\n}\n\nbuild_cmd() {\n    ensure_dirs\n    [[ -x \"$PROJECT/gradlew\" ]] || { echo \"ERROR: gradlew missing\" >&2; return 1; }\n    discover_java\n    export TZ=\"$MACHINA_TZ\"\n    export ANDROID_HOME=\"$(sdk_dir)\"\n    export ANDROID_SDK_ROOT=\"$ANDROID_HOME\"\n    export GRADLE_USER_HOME=\"$CACHE/gradle\"\n\n    local id output_dir snapshot_dir log apk\n    id=\"$(unique_id \"$(timestamp)\")\"\n    output_dir=\"$OUTPUTS/$id\"\n    snapshot_dir=\"$SNAPSHOTS/$id\"\n    log=\"$LOGS/build-$id.log\"\n    mkdir -p \"$output_dir\"\n    : > \"$log\"\n    (\n        cd \"$PROJECT\"\n        ./gradlew --no-daemon --no-configuration-cache assembleDebug\n    ) 2>&1 | tee -a \"$log\"\n    local exit_code=\"${PIPESTATUS[0]}\"\n\n    if [[ \"$exit_code\" -ne 0 ]]; then\n        printf 'Build ID: %s\\nStatus: FAILED\\nExit Code: %s\\n' \"$id\" \"$exit_code\" > \"$output_dir/BUILD_INFO.txt\"\n        cp -f \"$log\" \"$output_dir/build.log\"\n        (cd \"$output_dir\" && sha256sum build.log BUILD_INFO.txt > SHA256SUMS.txt)\n        echo \"FAILED: $output_dir\"\n        return \"$exit_code\"\n    fi\n\n    apk=\"$PROJECT/app/build/outputs/apk/debug/app-debug.apk\"\n    [[ -f \"$apk\" ]] || {\n        printf 'Build ID: %s\\nStatus: FAILED\\nExit Code: %s\\n' \"$id\" 1 > \"$output_dir/BUILD_INFO.txt\"\n        cp -f \"$log\" \"$output_dir/build.lo