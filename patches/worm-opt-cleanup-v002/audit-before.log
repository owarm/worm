93","name":"exec_command","arguments":"{\"cmd\":\"set -euo pipefail\\nPATCH=/opt/worm/patches/PATCH-INFRA-004-opnsense-hetzner-audit\\nmkdir -p \\\"$PATCH/backups\\\"\\ncp -a /opt/Android/dashboard/app/services/network_status.py \\\"$PATCH/backups/network_status.py.before\\\"\",\"sandbox_permissions\":\"require_escalated\",\"justification\":\"Serve creare directory patch sotto /opt/worm e backup del solo codice health-check prima della modifica.\",\"yield_time_ms\":30000,\"max_output_tokens\":4000}","call_id":"call_6iQs0cYMbzHyQITOHffiBzN0","internal_chat_message_metadata_passthrough":{"turn_id":"01a07cfd-824b-7f02-bc90-316a5bfb74bc","create_time":1788803820.490225}},{"type":"function_call_output","id":"fco_01a07d04-aa1a-73a1-8d3d-22c4653737e2","call_id":"call_6iQs0cYMbzHyQITOHffiBzN0","output":"Chunk ID: fedf8a\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 0\nOutput:\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a07cfd-824b-7f02-bc90-316a5bfb74bc","create_time":1788803852.8260753}},{"type":"message","id":"msg_0d4d71abca8c0b20016a9efb0e58fc87d2bf8969c7e3d1357c","role":"assistant","content":[{"type":"output_text","text":"Sto sostituendo il probe rigido con un health-check a livelli: discovery interfacce WG, peer/AllowedIPs, handshake, route verso target OPNsense rilevato, e reachability HTTPS/SSH-safe senza ICMP obbligatorio."}],"phase":"commentary","internal_chat_message_metadata_passthrough":{"turn_id":"01a07cfd-824b-7f02-bc90-316a5bfb74bc","create_time":1788803853.501947,"content_item_kinds":["unknown"]}},{"type":"custom_tool_call","id":"ctc_0d4d71abca8c0b20016a9efb0f7fd087d2b71bdfed1e90cead","status":"completed","call_id":"call_AGlMIrWCJTiLXOBydgmB9pa7","name":"apply_patch","input":"*** Begin Patch\n*** Update File: /opt/Android/dashboard/app/services/network_status.py\n@@\n import asyncio\n+import os\n import re\n from dataclasses import dataclass\n from datetime import datetime, timezone\n from time import monotonic\n from typing import Any\n@@\n CACHE_TTL_SECONDS = 20\n HANDSHAKE_MAX_AGE_SECONDS = 900\n-OPNSENSE_URL = \"https://10.60.0.1/\"\n+DEFAULT_OPNSENSE_HEALTH_URLS = (\"https://10.90.10.1/\", \"https://10.60.0.1/\")\n OPNSENSE_TIMEOUT_SECONDS = 4\n _cache: dict[str, Any] | None = None\n _cache_time = 0.0\n _lock = asyncio.Lock()\n@@\n class WireGuardState:\n     interface: str\n     wireguard: bool\n+    peer_configured: bool\n+    peer_count: int\n     handshake_recent: bool\n     handshake_age_seconds: int | None\n+    handshake: str\n+    allowed_ips: list[str]\n     route_present: bool\n     opnsense: bool\n+    opnsense_private: str | None\n+    opnsense_reachability: str\n+    root_cause: str | None\n     status: str\n     last_check: str\n@@\n def _discover_interfaces() -> list[str]:\n@@\n     return unique\n \n \n+def _wg_values(interface: str, field: str) -> dict[str, str]:\n+    code, out = run_readonly([\"wg\", \"show\", interface, field], timeout=5)\n+    if code != 0 or not out:\n+        return {}\n+    values: dict[str, str] = {}\n+    for line in out.splitlines():\n+        parts = line.split(maxsplit=1)\n+        if len(parts) == 2:\n+            values[parts[0]] = parts[1]\n+    return values\n+\n+\n def _inspect_interface(interface: str) -> dict[str, Any]:\n     code, out = run_readonly([\"wg\", \"show\", interface], timeout=5)\n     if code != 0 or not out:\n         return {\n             \"interface\": interface,\n             \"wireguard\": False,\n+            \"peer_configured\": False,\n+            \"peer_count\": 0,\n             \"handshake_recent\": False,\n             \"handshake_age_seconds\": None,\n+            \"handshake\": \"never\",\n+            \"allowed_ips\": [],\n             \"route_present\": False,\n             \"opnsense\": False,\n+            \"opnsense_private\": None,\n+            \"opnsense_reachability\": \"not_checked\",\n+            \"root_cause\": \"wireguard_interface_unavailable\",\n             \"status\": \"offline\",\n         }\n \n+    peers = [item for item in _wg_values(interface, \"peers\").keys() if item]\n+    allowed_by_peer = _wg_values(interface, \"allowed-ips\")\n+    allowed_ips: list[str] = []\n+    for peer in peers:\n+        allowed_ips.extend(allowed_by_peer.get(peer, \"\").split())\n+\n     handshakes: list[int] = []\n     for line in out.splitlines():\n         match = HANDSHAKE_RE.search(line)\n@@\n     handshake_age = min(handshakes) if handshakes else None\n     handshake_recent = handshake_age is not None and handshake_age <= HANDSHAKE_MAX_AGE_SECONDS\n     return {\n         \"interface\": interface,\n         \"wireguard\": True,\n+        \"peer_configured\": bool(peers),\n+        \"peer_count\": len(peers),\n         \"handshake_recent\": handshake_recent,\n         \"handshake_age_seconds\": handshake_age,\n+        \"handshake\": \"recent\" if handshake_recent else (\"stale\" if handshake_age is not None else \"never\"),\n+        \"allowed_ips\": sorted(set(allowed_ips)),\n         \"route_present\": False,\n         \"opnsense\": False,\n+        \"opnsense_private\": None,\n+        \"opnsense_reachability\": \"not_checked\",\n+        \"root_cause\": None if peers else \"wireguard_peer_missing\",\n         \"status\": \"offline\",\n     }\n \n \n-def _route_present() -> bool:\n-    code, out = run_readonly([\"ip\", \"route\", \"get\", \"10.60.0.1\"], timeout=5)\n+def _configured_opnsense_urls() -> list[str]:\n+    raw = os.environ.get(\"WORM_OPNSENSE_HEALTH_URLS\", \"\")\n+    urls = [item.strip() for item in raw.split(\",\") if item.strip()]\n+    for url in DEFAULT_OPNSENSE_HEALTH_URLS:\n+        if url not in urls:\n+            urls.append(url)\n+    return urls\n+\n+\n+def _host_from_url(url: str) -> str | None:\n+    match = re.match(r\"^[a-z]+://([^/:]+)\", url)\n+    return match.group(1) if match else None\n+\n+\n+def _route_present(host: str | None) -> bool:\n+    if not host:\n+        return False\n+    code, out = run_readonly([\"ip\", \"route\", \"get\", host], timeout=5)\n     if code != 0 or not out:\n         return False\n-    return \"dev \" in out and \"10.60.0.1\" in out\n+    return \"dev \" in out and host in out\n \n \n-async def _opnsense_reachable() -> bool:\n-    try:\n-        async with httpx.AsyncClient(\n-            timeout=httpx.Timeout(OPNSENSE_TIMEOUT_SECONDS),\n-            verify=False,\n-            follow_redirects=False,\n-        ) as client:\n-            response = await client.get(OPNSENSE_URL)\n-            return 200 <= response.status_code < 500\n-    except (httpx.TimeoutException, httpx.NetworkError, httpx.HTTPError):\n-        return False\n+async def _opnsense_reachability() -> dict[str, Any]:\n+    async with httpx.AsyncClient(\n+        timeout=httpx.Timeout(OPNSENSE_TIMEOUT_SECONDS),\n+        verify=False,\n+        follow_redirects=False,\n+    ) as client:\n+        for url in _configured_opnsense_urls():\n+            host = _host_from_url(url)\n+            if not _route_present(host):\n+                continue\n+            try:\n+                response = await client.get(url)\n+                server = response.headers.get(\"server\", \"\").lower()\n+                if 200 <= response.status_code < 500:\n+                    return {\n+                        \"opnsense\": True,\n+                        \"opnsense_private\": host,\n+                        \"route_present\": True,\n+                        \"opnsense_reachability\": f\"http_{response.status_code}\",\n+                        \"root_cause\": None,\n+                        \"server_header\": server or None,\n+                    }\n+            except (httpx.TimeoutException, httpx.NetworkError, httpx.HTTPError):\n+                continue\n+    return {\n+        \"opnsense\": False,\n+        \"opnsense_private\": None,\n+        \"route_present\": False,\n+        \"opnsense_reachability\": \"unreachable\",\n+        \"root_cause\": \"no_reachable_opnsense_end