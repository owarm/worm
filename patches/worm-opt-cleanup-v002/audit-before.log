roid.net.NetworkRequest;\n+import android.net.VpnManager;\n+import android.net.VpnService;\n+import android.os.Build;\n+import android.os.ParcelFileDescriptor;\n+import android.os.UserHandle;\n+import android.system.OsConstants;\n+import android.util.Log;\n+\n+import java.io.IOException;\n+import java.util.Collections;\n+\n+public final class WormSystemWireGuardService extends VpnService {\n+    public static final String ACTION_START = \"com.worm.systemwg.START\";\n+\n+    private static final String TAG = \"WormSystemWG\";\n+    private static final String CHANNEL_ID = \"worm_protected_network\";\n+    private static final int NOTIFICATION_ID = 1060;\n+\n+    private ParcelFileDescriptor mTun;\n+    private ConnectivityManager.NetworkCallback mNetworkCallback;\n+    private WormNetworkState mState = WormNetworkState.BLOCKED;\n+\n+    public static void start(Context context) {\n+        Intent intent = new Intent(context, WormSystemWireGuardService.class);\n+        intent.setAction(ACTION_START);\n+        context.startForegroundService(intent);\n+    }\n+\n+    @Override\n+    public void onCreate() {\n+        super.onCreate();\n+        createNotificationChannel();\n+        startForeground(NOTIFICATION_ID, buildNotification());\n+        enforceAlwaysOnLockdown();\n+        registerNetworkCallback();\n+        enterFailClosed(\"service created\");\n+    }\n+\n+    @Override\n+    public int onStartCommand(Intent intent, int flags, int startId) {\n+        enforceAlwaysOnLockdown();\n+        enterFailClosed(\"start command\");\n+        return START_STICKY;\n+    }\n+\n+    @Override\n+    public void onDestroy() {\n+        unregisterNetworkCallback();\n+        closeTun();\n+        super.onDestroy();\n+    }\n+\n+    private void registerNetworkCallback() {\n+        if (mNetworkCallback != null) {\n+            return;\n+        }\n+        ConnectivityManager connectivityManager = getSystemService(ConnectivityManager.class);\n+        if (connectivityMan